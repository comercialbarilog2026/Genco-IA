# ============ GENCO IA — configuração ============
# Copie este arquivo para .env e preencha. Nunca publique o .env.

# Endereço público do app (sem barra no final). Em produção, use https.
APP_URL=http://localhost:3000
PORT=3000

# Segredo longo e aleatório (mínimo 32 caracteres). Criptografa tokens de e-mail e sessões.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_SECRET=

# Caminho do banco de dados (SQLite)
DATABASE_PATH=./data/genco-ia.db

# ---------- Inteligência artificial ----------
# Provedor: anthropic | openai | mock  (mock = respostas simuladas, para testes sem chave)
AI_PROVIDER=mock
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------- Google (Gmail) ----------
# Console Google Cloud > APIs e serviços > Credenciais > ID do cliente OAuth (Aplicativo da Web)
# URI de redirecionamento autorizado: {APP_URL}/oauth/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Microsoft (Outlook / 365) ----------
# Portal Azure > Registros de aplicativo > Novo registro (contas de qualquer organização e pessoais)
# URI de redirecionamento (Web): {APP_URL}/oauth/outlook/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ---------- Stripe (assinatura) ----------
# Dashboard Stripe > Produtos > crie "GENCO IA" com preço recorrente mensal POR USUÁRIO.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Dashboard Stripe > Desenvolvedores > Webhooks > endpoint {APP_URL}/api/stripe/webhook
# Eventos: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=

# ---------- Regras do produto ----------
TRIAL_DAYS=14
# Intervalo da leitura automática das caixas (minutos)
SYNC_MINUTES=15
# Qualificar automaticamente e-mails novos a cada leitura (true/false)
AUTO_TRIAGE=true
# Limite de mensagens para a IA por usuário por mês (controle de custo)
AI_MONTHLY_LIMIT_PER_USER=600
